{
  "name": "network-monitoring-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf:deploy": "wrangler d1 migrations apply network-monitoring --remote && wrangler deploy",
    "cf:build": "npm run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply network-monitoring --local",
    "db:migrate:remote": "wrangler d1 migrations apply network-monitoring --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.5.0"
  }
}
