ISP_ID=isp2
PROBE_IP=<ISP2_PROBE_IP>
PROBE_MAC=02:00:00:00:00:04
TRACKER_IP=<ISP2_TRACKER_IP>
PROBE_CONTAINER_NAME=network-monitoring-probe-isp2
WORKER_URL=https://status.example.com/api/heartbeat
PROBE_SECRET=replace-with-isp2-probe-secret
SPEEDTEST_API_TOKEN=replace-with-speedtest-api-token
LOCAL_URL=http://history:8788
LOCAL_INGEST_TOKEN=replace-with-local-ingest-token
STATE_DIR=/state
LOCAL_SPOOL_DIR=/state/local-queue
METADATA_KEEPALIVE_SECONDS=21600
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
CHECK_PROVIDER=google
# Optional overrides for the selected provider profile.
# DNS_HOST=www.google.com
# HTTPS_CHECK_URL=https://www.google.com/generate_204
# INTERNET_CHECK_URL=https://www.google.com/generate_204
# TRACEROUTE_TARGET=9.9.9.9
PUBLIC_IP_URL=https://ipv4.icanhazip.com
TRACEROUTE_INTERVAL_SECONDS=900
TRACEROUTE_MAX_HOPS=8
TRACEROUTE_TIMEOUT_SECONDS=45
